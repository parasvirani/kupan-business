# Copy this file to android/key.properties and fill in your real values.
# android/key.properties and *.jks are gitignored — NEVER commit them.
#
# NOTE: kupan_business has no keystore yet — generate one first (see the keytool
# command in the Phase 7 report), place it in android/, then reference it here.
# storeFile is resolved relative to the android/ directory.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=CHANGE_ME
storeFile=kupanbusiness.jks
