<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules). Keep encrypted secrets out of both
     cloud backup and device-to-device transfer for the same reason. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
